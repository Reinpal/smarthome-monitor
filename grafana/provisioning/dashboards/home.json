    {
      "id": 70,
      "title": "Daily calendar energy · completed local days",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "description": "Each bar group is one COMPLETE local calendar day, labelled by its starting date. DST days are 23/25 hours when applicable; never rolling 24-hour totals or averages of period totals. Partially selected/current days and any day with gaps, stale tails or resets are omitted, NOT zero. Select one calendar month (at most 32 touched local dates); longer ranges are unavailable here. Meter import and estimated DC PV / site demand have distinct boundaries; do not stack or infer a power balance. Supported timezone horizon 2000–2100, not a claim of stored history.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "calendarMetric": "household",
          "calendarMode": "daily"
        },
        {
          "refId": "B",
          "calendarMetric": "grid_import",
          "calendarMode": "daily"
        },
        {
          "refId": "C",
          "calendarMetric": "pv",
          "calendarMode": "daily"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "quantity"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "day": 0
            },
            "renameByName": {
              "household": "Household (estimate)",
              "grid_import": "Grid import",
              "pv": "PV DC (estimate)"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "day",
                "destinationType": "time",
                "dateFormat": "X"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "formatTime",
          "options": {
            "timeField": "day",
            "outputFormat": "YYYY-MM-DD",
            "timezone": "browser"
          }
        }
      ],
      "options": {
        "xField": "day",
        "orientation": "vertical",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": -30
      }
