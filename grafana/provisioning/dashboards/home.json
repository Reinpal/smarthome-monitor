    {
      "id": 1,
      "title": "Household electricity",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "Selected local period; value is a continuous observed prefix, NOT an extrapolated total. See Coverage for exact observed endpoints and seconds. Missing/stale fields, leading/internal gaps, resets or mismatched periods withhold results; missing is never zero. Nominal 60-second interval/export resolution. Estimated integral of consumption-only device-calculated primary-meter site load; not independently metered whole-house demand.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "periodMetric": "household",
          "periodQualification": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "noValue": "Unavailable",
